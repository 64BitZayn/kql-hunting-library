// Password accepted, sign-in still failed (cloud-only authentication)
// ---------------------------------------------------------------
// Variant of correct-password-blocked-at-mfa.kql for tenants WITHOUT
// Password Hash Sync, where Entra ID doesn't label the step "Correct
// Password". It shows failed sign-ins that passed the cloud password
// step, so a later control (MFA, Conditional Access) stopped them.
// MITRE ATT&CK: T1078 Valid Accounts
let lookback = 1d;
let ExpectedCountries = dynamic(["DE"]);
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType != 0                     // the overall sign-in did not succeed
| where Location !in (ExpectedCountries)
| extend AuthDetails = parse_json(AuthenticationDetails)
| mv-expand AuthDetails
| where tostring(AuthDetails.authenticationMethodDetail) == "Password in the cloud"
| where tostring(AuthDetails.succeeded) == "true"   // the password step itself passed
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName,
          ResultType, ResultDescription,
          AuthenticationMethod = tostring(AuthDetails.authenticationMethod),
          StepResult           = tostring(AuthDetails.authenticationStepResultDetail),
          UserAgent, CorrelationId
| order by TimeGenerated desc
