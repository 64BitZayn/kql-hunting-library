// Correct password, then stopped at MFA
// ---------------------------------------------------------------
// Someone typed the right password but did not complete MFA. On an
// account whose owner wasn't travelling, that usually means the
// password is known to an attacker (phished, sprayed, reused) and
// MFA is the only thing left in the way: reset the password.
//
// Works when Password Hash Sync is enabled, because Entra ID then
// records "Correct Password" in the authentication details.
// MITRE ATT&CK: T1078 Valid Accounts, T1110 Brute Force
// Table: SigninLogs (Microsoft Sentinel / Entra ID diagnostics)
let lookback = 1d;
let ExpectedCountries = dynamic(["DE"]);   // ISO codes your users normally sign in from
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType == 50074                 // strong authentication (MFA) required
| where Location !in (ExpectedCountries)
| extend AuthDetails = parse_json(AuthenticationDetails)
| mv-expand AuthDetails
| where tostring(AuthDetails.authenticationStepResultDetail) has "Correct Password"
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName,
          ResultType, ResultDescription,
          AuthenticationMethod       = tostring(AuthDetails.authenticationMethod),
          AuthenticationMethodDetail = tostring(AuthDetails.authenticationMethodDetail),
          StepResult                 = tostring(AuthDetails.authenticationStepResultDetail),
          StepRequirement            = tostring(AuthDetails.authenticationStepRequirement),
          UserAgent, CorrelationId
| order by TimeGenerated desc
